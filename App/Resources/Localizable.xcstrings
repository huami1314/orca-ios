    "orcaios.push.gatewayFooter": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While Orca is open, alerts and Live Activities update right away. To get them after you close Orca, your desktop needs push turned on."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Orca 打开时，通知和实时活动会直接更新。关掉 Orca 后还想收到，需要桌面开启推送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Orca 開啟時，通知和即時動態會直接更新。關掉 Orca 後還想收到，需要桌面開啟推播。"
          }
        }
      }
    },
