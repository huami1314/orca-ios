          }
        }
      }
    },
    "diagnostics.troubleshootCommonIssues.disableVpn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disable that VPN or enable split tunneling / \"Allow LAN\"."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭该 VPN，或启用分流功能／“允许 LAN”选项"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "停用該 VPN，或啟用分割通道／「允許 LAN」。"
          }
        }
      }
    },
    "diagnostics.troubleshootCommonIssues.firewallTitle": {
      "extractionState": "manual",
