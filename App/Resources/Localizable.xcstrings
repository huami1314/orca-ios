        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對話無法返回到此訊息。未做任何更改。"
          }
        }
      }
    },
    "chat.rewind.outcomeUnknown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Orca couldn't confirm whether the conversation went back to an earlier message. It checks before your next message is sent."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Orca 无法确认对话是否已返回到更早的消息。它会在发送您的下一条消息前进行检查。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Orca 無法確認對話是否已返回到更早的訊息。它會在傳送您的下一則訊息前進行檢查。"
          }
        }
      }
    },
    "chat.rewind.outcomeUnknownReturned": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Orca couldn't confirm whether the conversation went back to this message. Your message is back in the composer, and Orca checks the conversation before your next message is sent."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
