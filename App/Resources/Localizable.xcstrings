    "bots.templates.bug-investigation.example1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproduced ORC-640 on Windows: paste drops the last line when it has no newline."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已在 Windows 上复现 ORC-640：当最后一行没有换行符时，粘贴会丢失这一行"
          }
        }
      }
    },
    "bots.templates.bug-investigation.example2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cause: the paste end marker goes out before the final chunk. Start a fix?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原因：粘贴结束标记在最后一个数据块之前就发出了。要开始修复吗？"
          }
        }
      }
    },
    "bots.templates.bug-investigation.firstChat": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give it a bug report or an issue link. It starts an agent in a new workspace that writes down how to reproduce it, then reports the cause. It writes a fix only after you agree."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "给它一份 Bug 报告或议题链接。它会在新工作区中启动智能体，写下复现步骤，然后报告原因。只有在你同意后，它才会编写修复"
          }
        }
      }
    },
