    "components.useCodexResetCreditAction.hostAccountConfirmMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This spends one earned reset for %1$@ on the host and immediately resets eligible rate-limit windows."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会为主机上的 %1$@ 消耗一次已获得的重置额度，并立即重置符合条件的用量窗口"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會為主機上的 %1$@ 使用一次已獲得的重設額度，並立即重設符合條件的用量週期。"
          }
        }
      }
    },
