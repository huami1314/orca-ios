    "app.terminalSettings.leaveAppDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While you're using a terminal on your phone, Orca shrinks it to fit your screen. When you close the app or switch away, this controls whether it stays at phone size (so interactive CLI tools don't reflow) or resizes back to your desktop. You can always use Restore on the desktop banner to resize manually."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在手机上使用终端时，Orca 会缩小终端尺寸以适应屏幕。关闭应用或切换到其他应用时，此设置决定终端是保持手机尺寸（避免交互式 CLI 工具的界面重新排版），还是恢复为桌面尺寸。您随时可以点击桌面横幅中的“恢复”手动调整尺寸"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在手機上使用終端機時，Orca 會將終端機縮小以符合螢幕大小。關閉 App 或切換到其他 App 時，此設定決定終端機要保持手機尺寸（避免互動式 CLI 工具重新排版），還是還原為電腦上的尺寸。您隨時都能使用桌面版橫幅上的「還原」手動調整尺寸。"
          }
        }
      }
    },
    "app.terminalSettings.leaveAppHeading": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "WHEN YOU LEAVE THE APP"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "离开应用时"
          }
        },
        "zh-Hant": {
          "stringUnit": {
