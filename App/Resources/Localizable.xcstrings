    "diagnostics.troubleshootCommonIssues.keepTailscaleOn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Host addresses like 100.x.x.x or *.ts.net connect through Tailscale — keep it ON."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "100.x.x.x 或 *.ts.net 等主机地址通过 Tailscale 连接，请保持 Tailscale 开启"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "100.x.x.x 或 *.ts.net 等主機位址會透過 Tailscale 連線，請保持 Tailscale 開啟。"
          }
        }
      }
    },
    "diagnostics.troubleshootCommonIssues.linuxFirewall": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Linux: sudo ufw allow %1$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
