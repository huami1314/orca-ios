    },
    "settings.notificationDisplayTest.accepted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accepted by Orca’s push service. Check for the notification."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
