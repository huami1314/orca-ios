    },
    "diagnostics.troubleshootCommonIssues.reconnectWifi": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try reconnecting WiFi on both devices."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尝试在两台设备上重新连接 WiFi"
          }
