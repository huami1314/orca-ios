          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimi 收到空白的提示詞。請修正產生文字的動作範本或 CLI 引數中的該項輸入，然後再試一次。"
          }
        }
      }
    },
    "sourceControl.textGenerationFailure.kimiFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimi couldn't finish generating text. Open Kimi on the execution host to check the failure before retrying."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimi 未能完成文本生成。请在执行主机上打开 Kimi，检查失败原因后再重试"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimi 無法完成文字產生作業。請在執行主機上開啟 Kimi，檢查失敗原因後再試一次。"
          }
        }
      }
    },
    "sourceControl.textGenerationFailure.kimiInterrupted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimi was interrupted before it finished generating text. Try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimi 在完成文本生成前被中断。请重试"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimi 在完成文字產生前遭到中斷。請再試一次。"
          }
        }
      }
    },
    "sourceControl.textGenerationFailure.kimiModelMissing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimi has no usable model configured. Open Kimi on the execution host to configure or select a model, then retry."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimi 未配置可用模型。请在执行主机上打开 Kimi，配置或选择模型，然后重试"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimi 未設定可用的模型。請在執行主機上開啟 Kimi，設定或選取模型，然後再試一次。"
          }
        }
      }
    },
    "sourceControl.textGenerationFailure.kimiOptionRejected": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimi rejected an option or argument. Correct the generation recipe or CLI arguments, then retry."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimi 拒绝了某个选项或参数。请修正生成预设或 CLI 参数，然后重试"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimi 拒絕了某個選項或引數。請修正產生文字的動作範本或 CLI 引數，然後再試一次。"
          }
        }
      }
    },
    "sourceControl.textGenerationFailure.kimiOutputFormatInvalid": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimi output format requires prompt mode and a supported text or stream-json value. Correct the generation recipe or CLI arguments before retrying."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimi 输出格式需要提示词模式及受支持的 text 或 stream-json 值。请在重试前修正生成预设或 CLI 参数"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimi 輸出格式需要提示詞模式及支援的 text 或 stream-json 值。請在重試前修正產生文字的動作範本或 CLI 引數。"
          }
        }
      }
    },
    "sourceControl.textGenerationFailure.kimiPromptHookBlocked": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A Kimi prompt hook blocked the request or the turn couldn't start. Review Kimi hooks and configuration before retrying."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimi 提示词钩子阻止了请求，或无法启动此轮交互。请在重试前检查 Kimi 钩子和配置"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimi 提示詞鉤子封鎖了要求，或無法開始此回合。請在重試前檢查 Kimi 鉤子和設定。"
          }
        }
      }
    },
    "sourceControl.textGenerationFailure.kimiProviderLimited": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimi reached a provider limit or the provider is busy. Wait before retrying or reduce request frequency."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimi 已达到提供者限制，或提供者正忙。请等待后再重试，或降低请求频率"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimi 已達到提供者的限制，或提供者正忙碌中。請稍候再試，或降低要求頻率。"
          }
        }
      }
    },
    "sourceControl.textGenerationFailure.kimiResponseBlocked": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimi could not return a response because it was blocked. Revise the prompt or model configuration before retrying."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimi 无法返回响应，因为响应被阻止。请在重试前修改提示词或模型配置"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimi 無法傳回回應，因為回應遭到封鎖。請在重試前修改提示詞或模型設定。"
          }
        }
      }
    },
    "sourceControl.textGenerationFailure.kimiSessionIdRequired": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimi needs a session id to resume in prompt mode. Correct the generation recipe or CLI arguments, then retry."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimi 在提示词模式下恢复会话需要会话 ID。请修正生成预设或 CLI 参数，然后重试"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimi 在提示詞模式下繼續工作階段時需要工作階段 ID。請修正產生文字的動作範本或 CLI 引數，然後再試一次。"
          }
        }
      }
    },
    "sourceControl.textGenerationFailure.kimiSessionNotFound": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimi couldn't find the requested session. Use an existing session or start a new one."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimi 找不到请求的会话。请使用现有会话或启动新会话"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimi 找不到要求的工作階段。請使用現有的工作階段或啟動新的工作階段。"
          }
        }
      }
    },
    "sourceControl.textGenerationFailure.kimiSessionOccupied": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimi couldn't use this session because it is active in another client. Stop the session there or exit that client, then try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
