            "value": "区分偶发的检查失败、真实失败和基础设施故障，并找出引入问题的提交"
          }
        }
      }
    },
    "bots.templateSkills.lines.dependency-upgrade": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upgrade one group at a time, read the changelog, run the tests, one pull request each."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次升级一组，阅读更新日志，运行测试，每组一个 PR"
          }
        }
      }
    },
    "bots.templateSkills.lines.feedback-themes": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Group feedback into themes with counts and short quotes; link existing issues."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将反馈按主题归类，附上数量和简短引述；关联已有议题"
          }
        }
      }
    },
    "bots.templateSkills.lines.incident-timeline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep a timestamped timeline, then draft a blameless write-up."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "维护带时间戳的时间线，然后起草不追责的事后报告"
          }
        }
      }
    },
    "bots.templateSkills.lines.issue-triage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Label, find duplicates, ask for missing repro details in one comment."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加标签、查找重复项，并在一条评论中索取缺失的复现细节"
          }
        }
      }
    },
    "bots.templateSkills.lines.pr-review-checklist": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read a diff for behaviour changes, missing tests and risky edits; cite each finding."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "阅读差异，查找行为变化、缺失的测试和有风险的修改；每项发现都要注明出处"
          }
        }
      }
    },
    "bots.templateSkills.lines.release-notes-style": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notes for users: new, fixed, changed; leave out refactors and code names."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "面向用户的说明：新增、修复、变更；不写重构和代号"
          }
        }
      }
    },
    "bots.templateSkills.lines.release-readiness": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What blocks a release and how to list it: checks, reviews, open blockers."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "哪些事项会阻碍发布以及如何列出：检查、评审、未解决的阻碍项"
          }
        }
      }
    },
    "bots.templateSkills.lines.security-checklist": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Secrets, injection, auth checks and unsafe defaults to look for in a change."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在更改中要检查的密钥、注入、鉴权检查和不安全的默认值"
          }
        }
      }
    },
    "bots.templateSkills.lines.spec-format": {
