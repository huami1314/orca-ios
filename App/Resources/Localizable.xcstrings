    "bots.templates.ci-failures.does": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tells flaky checks from real failures, explains each failure, and keeps a list of flaky checks."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "区分偶发失败和真实失败，解释每次失败，并维护一份不稳定检查的清单"
          }
        }
      }
    },
    "bots.templates.ci-failures.events.check-failed.action": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Say whether it’s flaky or real"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "判断是偶发还是真实失败"
          }
        }
      }
    },
    "bots.templates.ci-failures.events.check-failed.trigger": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When a check fails"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当检查失败时"
          }
        }
      }
    },
    "bots.templates.ci-failures.example1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "#4130 typecheck: a renamed export, two call sites missed. Fix is one commit."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "#4130 typecheck：导出被重命名，漏改了两处调用。修复只需一次提交"
          }
        }
      }
    },
    "bots.templates.ci-failures.example2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Flakiest this week: terminal-resize test, 4 of 30 runs."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本周最不稳定：terminal-resize 测试，30 次运行中失败 4 次"
          }
        }
      }
    },
    "bots.templates.ci-failures.firstChat": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reads the last two weeks of check runs and lists the flaky ones, then explains each failing check on your open pull requests. It starts a fix only after you agree."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读取最近两周的检查运行记录并列出不稳定的检查，然后解释你未关闭的 PR 上每项失败的检查。只有在你同意后，它才会开始修复"
          }
        }
      }
    },
    "bots.templates.ci-failures.line": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Explains failed checks and keeps a list of flaky ones."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解释失败的检查，并维护一份不稳定检查的清单"
          }
        }
      }
    },
    "bots.templates.ci-failures.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CI failures"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CI 失败"
          }
        }
      }
    },
    "bots.templates.ci-failures.needsSetup": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub can’t filter failures by branch yet, so the bot looks at every failure in the repo and skips the ones that don’t matter. Each one costs a turn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub 暂时无法按分支筛选失败，因此 bot 会查看仓库中的每一次失败，并跳过无关的失败。每次都会消耗一个回合"
          }
        }
      }
    },
    "bots.templates.ci-failures.reports": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Here, Mondays at 9 AM and when a check fails"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在这里，每周一上午 9 点以及检查失败时"
          }
        }
      }
    },
