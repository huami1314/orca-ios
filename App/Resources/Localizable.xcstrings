    "settings.notificationDisplayTest.disabled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are turned off in Orca. Enable notifications and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Orca 中的通知已关闭。请启用通知后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Orca 中的通知已關閉。請啟用通知後再試。"
          }
        }
      }
    },
    "settings.notificationDisplayTest.hostClockSkew": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The clock on %1$@ is off by %2$@ seconds, so Orca’s push service refused it. Set its clock to the correct time and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 的时钟偏差了 %2$@ 秒，因此 Orca 的推送服务拒绝了它。请将时钟设为正确时间后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 的時鐘偏差了 %2$@ 秒，因此 Orca 的推播服務拒絕了它。請將時鐘設定為正確時間後再試一次。"
          }
        }
      }
    },
    "settings.notificationDisplayTest.hostClockSkewDuration": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The clock on %1$@ is off by %2$@, so Orca’s push service refused it. Set its clock to the correct time and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 的时钟偏差了 %2$@，因此 Orca 的推送服务拒绝了它。请将时钟设为正确时间后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 的時鐘偏差了 %2$@，因此 Orca 的推播服務拒絕了它。請將時鐘設定為正確時間後再試一次。"
          }
        }
      }
    },
    "settings.notificationDisplayTest.liveFallbackScheduled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Local test scheduled. Check for the notification. Live alerts are available while Orca is running and connected."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 已安排本地测试。请检查通知。Orca 运行且保持连接时，可接收实时提醒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 已安排本機測試。請檢查通知。Orca 執行且保持連線時，可接收即時提醒。"
          }
        }
      }
