    "diagnostics.troubleshootCommonIssues.macosFirewall": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS: System Settings → Network → Firewall — allow Orca."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS：系统设置 → 网络 → 防火墙，允许 Orca 通过"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS：「系統設定」→「網路」→「防火牆」，允許 Orca 連線。"
          }
        }
      }
    },
    "diagnostics.troubleshootCommonIssues.notificationNetwork": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try cellular or another Wi-Fi network. If alerts arrive after switching, your network may be delaying delivery."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尝试切换到蜂窝网络或其他 Wi-Fi 网络。如果切换后能收到通知，则原网络可能导致通知延迟"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
