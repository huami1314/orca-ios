          }
        }
      }
    },
    "settings.notificationDisplayTest.connectDesktop": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect a desktop and try again."
          }
        },
        "zh-Hans": {
