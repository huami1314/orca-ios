            "value": "試著讓兩部裝置重新連上 WiFi。"
          }
        }
      }
    },
    "diagnostics.troubleshootCommonIssues.restartBothApps": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restart both apps if timeouts persist."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果持续超时，请重启手机端和桌面端应用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若持續逾時，請重新啟動兩端的應用程式。"
          }
        }
      }
    },
    "diagnostics.troubleshootCommonIssues.restartDesktop": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try restarting Orca — the companion server starts on launch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尝试重启 Orca，移动端连接服务会随应用启动"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "試著重新啟動 Orca，行動版連線伺服器會隨之啟動。"
          }
        }
      }
    },
    "diagnostics.troubleshootCommonIssues.restartTailscale": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS/Android can silently wedge the tunnel: toggle Tailscale off and back on in the Tailscale app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS/Android 可能在无提示的情况下导致隧道卡住：请在 Tailscale 应用中关闭 Tailscale 后再重新开启"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS/Android 可能導致通道卡住而沒有任何提示。請在 Tailscale 應用程式中關閉 Tailscale，再重新開啟。"
          }
        }
      }
    },
    "diagnostics.troubleshootCommonIssues.restrictedNetwork": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
