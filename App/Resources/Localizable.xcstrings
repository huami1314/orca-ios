    "onboarding.onboardingPage.notificationsDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get a notification on this phone when an agent finishes or is waiting — even if you aren’t using the app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "智能体完成任务或等待响应时，即使未使用应用，此手机也会收到通知"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "即使未使用應用程式，代理程式完成工作或等待您回應時，此手機也會收到通知。"
          }
        }
      }
    },
    "onboarding.onboardingPage.notificationsDisclosure": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delivered through Orca’s push service after your desktop has been idle for 3 minutes. Change this anytime in Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "桌面空闲 3 分钟后，通过 Orca 的推送服务发送通知。可随时在“设置”中更改"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "電腦閒置 3 分鐘後，便會透過 Orca 推播服務傳送通知。您隨時可在「設定」中變更。"
          }
        }
      }
    },
