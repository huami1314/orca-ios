      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull request review"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PR 评审"
          }
        }
      }
