    "session.failure.agentCommandFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@'s Command in Settings → Agents didn't start %1$@: %2$@. Change it or reset it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置 → 智能体中%1$@的“命令”未能启动 %1$@：%2$@。请修改或重置命令。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 在「設定 → 代理程式」中的命令未能啟動 %1$@：%2$@。請修改或重設。"
          }
        }
      }
    },
    "session.failure.agentCommandNotRunnable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@'s Command in Settings → Agents must be a program path or name Orca can find, with no arguments or variables. Change it or reset it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 在设置 → 智能体中的命令必须是 Orca 能找到的程序路径或名称，且不能包含参数或变量。请修改或重置"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 在「設定 → 代理程式」中的命令必須是 Orca 能找到的程式路徑或名稱，且不能包含引數或變數。請修改或重設。"
          }
        }
      }
    },
