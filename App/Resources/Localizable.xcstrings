    "accounts.claude.usageSignInMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected Claude account needs you to sign in again. Open Settings > AI Provider Accounts, or choose System default."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选 Claude 账户需要您重新登录，请打开设置 > AI 提供商账户，或选择系统默认"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所選 Claude 帳戶需要您重新登入。請開啟設定 > AI 供應商帳戶，或選擇系統預設。"
          }
        }
      }
    },
