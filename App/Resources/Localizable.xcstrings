    "sourceControl.textGenerationFailure.jiraSummaryEmptyAfterSanitization": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Generated summary was empty after sanitization."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "生成的标题在清理后为空"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "產生的摘要在清理後為空白。"
          }
        }
      }
    },
    "sourceControl.textGenerationFailure.kimiAgentChangeOnResume": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimi cannot change the agent when resuming a session. Remove the agent override or start a new session in the generation recipe or CLI arguments."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimi 无法在恢复会话时更改智能体。请修改生成预设或 CLI 参数，移除智能体覆盖设置或改为启动新会话"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimi 無法在繼續工作階段時變更代理程式。請移除代理程式覆寫設定，或在產生文字的動作範本或 CLI 引數中啟動新的工作階段。"
          }
        }
      }
    },
    "sourceControl.textGenerationFailure.kimiAgentOptionsConflict": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimi received conflicting or repeated agent options. Keep a single --agent or --agent-file option in the generation recipe or CLI arguments, then retry."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimi 收到了冲突或重复的智能体选项。请在生成预设或 CLI 参数中仅保留一个 --agent 或 --agent-file 选项，然后重试"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimi 收到衝突或重複的代理程式選項。請在產生文字的動作範本或 CLI 引數中僅保留一個 --agent 或 --agent-file 選項，然後再試一次。"
          }
        }
      }
    },
    "sourceControl.textGenerationFailure.kimiAuthFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimi could not authenticate. Sign in or correct provider credentials on the execution host, then retry."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimi 无法通过身份验证。请在执行主机上登录或修正提供者凭据，然后重试"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimi 無法通過驗證。請在執行主機上登入或修正提供者憑證，然後再試一次。"
          }
        }
      }
    },
    "sourceControl.textGenerationFailure.kimiCancelled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimi cancelled the request before it finished generating text. Try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimi 在完成文本生成前取消了请求。请重试"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimi 在完成文字產生前取消了要求。請再試一次。"
          }
        }
      }
    },
    "sourceControl.textGenerationFailure.kimiConfigInvalid": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimi has invalid configuration. Check the model and provider configuration on the execution host before retrying."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimi 的配置无效。请在重试前检查执行主机上的模型和提供者配置"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimi 的設定無效。請在重試前檢查執行主機上的模型和提供者設定。"
          }
        }
      }
    },
    "sourceControl.textGenerationFailure.kimiConflictingOptions": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimi received conflicting options: %1$@ with %2$@. Correct the generation recipe or CLI arguments before retrying."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimi 收到了冲突的选项：%1$@ 与 %2$@。请在重试前修正生成预设或 CLI 参数"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimi 收到衝突的選項：%1$@ 與 %2$@。請在重試前修正產生文字的動作範本或 CLI 引數。"
          }
