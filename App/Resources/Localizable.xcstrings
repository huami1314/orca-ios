          }
        }
      }
    },
    "settings.notificationDisplayTest.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Test push delivery, or a local notification when push is unavailable."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "测试推送送达；推送不可用时，测试本地通知。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "測試推播送達；推播無法使用時，測試本機通知。"
          }
        }
      }
    },
    "settings.notificationDisplayTest.desktopUnreachable": {
