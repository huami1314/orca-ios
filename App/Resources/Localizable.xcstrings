    "settings.nativeNotificationDeliverySettings.updateDesktopHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pair an updated host to receive notifications on this phone."
          }
        },
        "zh-Hans": {
