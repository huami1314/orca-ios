    "bots.templates.comesWithNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Schedules start turned off. Automations and connectors are set up in its first chat, once you pick the repo or channel."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "计划初始为关闭状态。选定仓库或频道后，会在它的首次聊天中设置自动化和连接器"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "計劃預設關閉。自動化和聯結器會在第一次聊天中、你選擇存放庫或頻道後設定。"
          }
        }
      }
    },
    "bots.templates.dependency-updates.does": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lists advisories and outdated packages, most urgent first; upgrades one group per pull request once agreed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "列出安全公告和过时的包，最紧急的排在最前；经同意后，每组用一个 PR 升级"
          }
        }
      }
    },
    "bots.templates.dependency-updates.example1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1 advisory: http-client 6.19 has a high-severity fix in 6.21."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1 条安全公告：http-client 6.19 的高危问题已在 6.21 中修复"
          }
        }
      }
    },
