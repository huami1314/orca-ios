        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此對話過長，無法回溯。未做任何更改。"
          }
        }
      }
    },
    "chat.rewind.historyNotPaginated": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This older Codex chat can't go back to an earlier message. Start a new chat to use Rewind to here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此旧版 Codex 聊天无法返回到更早的消息。请开始新聊天以使用“回溯到此处”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此舊版 Codex 聊天無法返回到更早的訊息。請開始新聊天以使用「回溯到此處」。"
          }
        }
      }
    },
    "chat.rewind.invalidTarget": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The conversation can't go back to this message. Nothing was changed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对话无法返回到此消息。未做任何更改。"
