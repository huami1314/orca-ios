    "diagnostics.troubleshootCommonIssues.allowNotifications": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check that system settings allow Orca notifications and that Focus or Do Not Disturb is off."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查系统设置是否允许 Orca 发送通知，并确认专注模式或勿扰模式已关闭"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "確認系統設定允許 Orca 傳送通知，且「專注模式」或「勿擾模式」已關閉。"
          }
        }
      }
    },
    "diagnostics.troubleshootCommonIssues.checkTailnet": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the desktop is awake and shows as connected in your tailnet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认桌面未休眠，并在 tailnet 中显示为已连接"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "確認電腦未進入睡眠，且在您的 tailnet 中顯示為已連線。"
          }
        }
      }
    },
    "diagnostics.troubleshootCommonIssues.desktopTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
