    "bots.templates.pr-review.does": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reviews each one and lists risky changes and missing tests, with file and line."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "逐一评审，列出有风险的更改和缺失的测试，并附上文件和行号"
          }
        }
      }
    },
    "bots.templates.pr-review.events.review-requested.action": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review it and post here"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "评审并发到这里"
          }
        }
      }
    },
    "bots.templates.pr-review.events.review-requested.trigger": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you’re asked to review a pull request"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当有人请你评审 PR 时"
          }
        }
      }
    },
    "bots.templates.pr-review.example1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "#4121: the retry counter is never reset, so a second outage stops retries."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "#4121：重试计数器从不重置，因此第二次中断后会停止重试"
          }
        }
      }
    },
    "bots.templates.pr-review.example2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No test covers the new timeout path."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新的超时路径没有测试覆盖"
          }
        }
      }
    },
    "bots.templates.pr-review.firstChat": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Asks which repos to cover, then reviews the open pull requests waiting on your review and posts its findings here, with file and line. It doesn’t comment on GitHub until you say it can."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先询问要覆盖哪些仓库，然后评审等待你评审的未关闭 PR，并把发现连同文件和行号发到这里。在你允许之前，它不会在 GitHub 上发表评论"
          }
        }
      }
    },
    "bots.templates.pr-review.line": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reviews pull requests you’re asked to review and lists risky changes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "评审请你评审的 PR，并列出有风险的更改"
          }
        }
      }
    },
