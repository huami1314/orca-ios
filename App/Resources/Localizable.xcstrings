          "stringUnit": {
            "state": "translated",
            "value": "%1$@'s setup is changing on this host. Try again after it finishes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在此主机上更改 %1$@ 的设置。请在完成后重试"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 在此主機上的設定正在變更。請在完成後重試。"
          }
